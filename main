import java.util.Scanner;

public class main {
    public static void main(String[] args) {
        int[] numbers = {10, 20, 30, 40, 50};

        System.out.println("Массив:");
        for (int i = 0; i < 5; i++) {
            System.out.print(numbers[i] + " ");
        }
        System.out.println();


        Scanner scanner = new Scanner(System.in);

        System.out.print("Что сделать? (1 - добавить, 2 - удалить): ");
        int choice = scanner.nextInt();

        if (choice == 1) {
            System.out.print("Введите число для добавления: ");
            int num = scanner.nextInt();


            int[] big = new int[6];

            for (int i = 0; i < 5; i++) {
                big[i] = numbers[i];
            }

            big[5] = num;

            System.out.println("Стало:");
            for (int i = 0; i < 6; i++) {
                System.out.print(big[i] + " ");
            }
        }

        if (choice == 2) {
            System.out.print("Какой индекс удалить (0-4): ");
            int index = scanner.nextInt();

            if (index < 0 || index > 4) {
                System.out.println("Ошибка: такого индекса нет!");
            } else {
                System.out.println("Стало (без элемента " + index + "):");
                for (int i = 0; i < 5; i++) {
                    if (i != index) {
                        System.out.print(numbers[i] + " ");
                    }
                }
            }
        }

        if (choice != 1 && choice != 2) {
            System.out.println("Неверная команда");
        }

        scanner.close();
    }
}
